<div class="text-light font-iregular flex flex-col min-h-screen">
  <div class="min-h-screen">
    <.navbar
      pages={PearlWeb.Config.landing_pages(Map.get(assigns, :current_user))}
      registrations_open?={Pearl.Event.registrations_open?()}
      current_user={Map.get(assigns, :current_user)}
    />
    <main class="flex-1 flex flex-col">
      <.flash_group flash={@flash} />
      <div class="flex-1 bg-muted flex flex-col">
        <div class="flex gap-8 place-items-center px-10 py-4">
          <h1 class="text-black font-bold">Inscrição</h1>
          <.live_component
            module={PearlWeb.Checkout.Components.StepTabs}
            id="ticket-checkout-step-tabs"
            tabs={[
              :registration,
              :confirmation_pending,
              :choose_ticket,
              :precautions,
              :informations,
              :conclusion,
              :payment,
              :payment_status
            ]}
            action={@live_action}
            patch={~p"/checkout/precautions"}
          />
        </div>
        <div class="flex-1 p-6 overflow-auto flex flex-col justify-center">
          {@inner_content}
        </div>
      </div>
    </main>
  </div>
  <.footer />
</div>
