<.page title={gettext("Horse Race")}>
  <%= if @horse_race_active? do %>
    <% total_bets = @horse_bets |> Map.values() |> Enum.sum() %>
    <% available_tokens = @attendee_tokens - total_bets %>

    <div class="space-y-4">
      <%!-- Balance Bar --%>
      <div class="relative overflow-hidden rounded-2xl border border-red-800/40 from-red-950/60 via-red-900/20 to-transparent p-5 shadow-xl">
        <div class="absolute inset-0 from-rose-900/10 to-transparent pointer-events-none" />
        <div class="relative flex items-center justify-between">
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-red-400/70">
              {gettext("Your Balance")}
            </p>
            <p class="mt-1 text-3xl font-bold text-white">
              {format_tokens(@attendee_tokens)}
              <span class="ml-1 text-base font-normal text-gray-400">tokens</span>
            </p>
          </div>
          <div class="flex h-14 w-14 items-center justify-center rounded-full border border-red-700/50 bg-red-900/40 shadow-lg shadow-red-900/30">
            <img src="/images/icons/horse.png" alt="Horse" class="w-8 h-8" />
          </div>
        </div>
        <div class="relative mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 border-t border-red-900/30 pt-3 text-sm">
          <div>
            <span class="text-gray-500">{gettext("Bet")}: </span>
            <span class="font-semibold text-accent">{format_tokens(total_bets)}</span>
          </div>
          <div class="h-3 w-px bg-white/10" />
          <div>
            <span class="text-gray-500">{gettext("Available")}: </span>
            <span class="font-semibold text-white">{format_tokens(available_tokens)}</span>
          </div>
          <div class="h-3 w-px bg-white/10" />
          <div>
            <span class="text-gray-500">{gettext("Win multiplier")}: </span>
            <span class="font-bold text-accent">{format_tokens(@multiplier)}x</span>
          </div>
        </div>
      </div>

      <%!-- Active Bets --%>
      <%= if length(@active_bets) > 0 do %>
        <div class="rounded-2xl border border-accent/30  from-accent/5 to-transparent p-4">
          <div class="mb-3 flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-accent/20 border border-accent/30">
              <img src="/images/icons/horse.png" alt="Horse" class="w-4 h-4" />
            </div>
            <h3 class="text-sm font-bold text-accent uppercase tracking-wide">
              {gettext("Your Active Bets")}
            </h3>
            <span class="ml-auto animate-pulse rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
              ⏳ {gettext("In progress")}
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
            <%= for bet <- @active_bets do %>
              <div class="flex items-center gap-2 rounded-xl border border-accent/20 bg-black/30 px-3 py-2">
                <img src="/images/icons/horse.png" alt="Horse" class="w-7 h-7 shrink-0" />
                <div class="min-w-0">
                  <p class="text-sm font-bold text-accent">#{bet.horse_number}</p>
                  <p class="truncate text-xs text-gray-400">
                    {format_tokens(bet.bet_amount)}
                    <span class="text-gray-600">→</span>
                    <span class="text-green-400 font-semibold">
                      {(format_tokens(bet.bet_amount) * @multiplier) |> format_tokens()}
                    </span>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%!-- Betting Section --%>
      <div class="overflow-hidden rounded-2xl border border-red-900/30 bg-black/40 shadow-2xl">
        <%!-- Header --%>
        <div class="flex items-center gap-4 border-b border-red-900/20 from-primary/25 via-red-900/10 to-transparent px-5 py-4">
          <div class="relative">
            <div class="absolute inset-0 rounded-full bg-primary/40 blur-md" />
            <img
              src="/images/icons/horse.png"
              alt="Horse"
              class="relative w-14 h-14 drop-shadow-lg"
            />
          </div>
          <div>
            <h3 class="text-xl font-bold text-white">{gettext("Place Your Bets")}</h3>
            <p class="text-xs text-gray-400 mt-0.5">
              {gettext("Pick your horses and confirm when ready")}
            </p>
          </div>
        </div>

        <%!-- Horse Grid --%>
        <div class="p-4">
          <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
            <%= for horse_num <- 1..@number_of_horses do %>
              <% horse_bet = Map.get(@horse_bets, horse_num, 0) %>
              <% has_bet = horse_bet > 0 %>
              <div class={[
                "group relative flex flex-col items-center rounded-xl border-2 p-3 transition-all duration-200",
                if(has_bet,
                  do: "border-accent/60 bg-accent/5 shadow-md shadow-accent/10",
                  else:
                    "border-red-900/30 bg-red-950/10 hover:border-red-700/40 hover:bg-red-950/20"
                )
              ]}>
                <%!-- Horse number badge --%>
                <div class={[
                  "mb-2 flex h-5 w-8 items-center justify-center rounded-full text-xs font-bold",
                  if(has_bet,
                    do: "bg-accent/20 text-accent",
                    else: "bg-red-900/40 text-red-400/80"
                  )
                ]}>
                  #{horse_num}
                </div>

                <img
                  src="/images/icons/horse.png"
                  alt={"Horse #{horse_num}"}
                  class="mb-2 w-12 h-12"
                />

                <form phx-change="update_horse_bet" class="w-full">
                  <input type="hidden" name="horse" value={horse_num} />
                  <input
                    type="number"
                    name="amount"
                    phx-debounce="300"
                    value={if has_bet, do: horse_bet, else: ""}
                    min="1"
                    step="1"
                    max={trunc(available_tokens + horse_bet)}
                    placeholder={gettext("Amount...")}
                    disabled={length(@active_bets) > 0}
                    class="w-full rounded-lg border border-red-900/30 bg-black/50 px-2 py-1.5 text-center text-xs font-bold text-white placeholder-red-900/50 focus:border-rose-600 focus:outline-none focus:ring-1 focus:ring-rose-600/30 disabled:cursor-not-allowed disabled:opacity-40"
                  />
                </form>

                <%= if has_bet do %>
                  <button
                    phx-click="clear_horse_bet"
                    phx-value-horse={horse_num}
                    class="mt-1.5 w-full rounded-lg border border-red-700/30 bg-red-700/10 py-1 text-xs text-red-500 transition hover:bg-red-700/20"
                  >
                    <.icon name="hero-trash" class="inline h-3 w-3 mr-0.5" />
                    {gettext("Clear")}
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Action Buttons --%>
        <div class="flex gap-3 border-t border-red-900/20 bg-red-950/10 px-5 py-4">
          <button
            phx-click="clear_all_bets"
            disabled={map_size(@horse_bets) == 0 || length(@active_bets) > 0}
            class="flex items-center gap-2 rounded-xl border border-rose-800/40 bg-rose-900/20 px-4 py-2.5 text-sm font-semibold text-rose-400 transition hover:bg-rose-900/30 disabled:cursor-not-allowed disabled:opacity-40"
          >
            <.icon name="hero-trash" class="h-4 w-4" />
            {gettext("Clear All")}
          </button>
          <button
            phx-click="confirm_bets"
            disabled={map_size(@horse_bets) == 0 || length(@active_bets) > 0}
            class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary/40 transition-colors hover:bg-red-700/40 disabled:cursor-not-allowed disabled:opacity-40"
            style="transform: none !important;"
          >
            <.icon name="hero-check-circle" class="h-4 w-4" />
            {gettext("Confirm Bets")}
            <span class="ml-1 rounded-full bg-white/15 px-2 py-0.5 text-xs font-normal">
              {format_tokens(total_bets)} tokens
            </span>
          </button>
        </div>

        <%= if length(@active_bets) > 0 do %>
          <p class="px-5 pb-4 text-center text-xs font-medium text-accent/80">
            {gettext("You have active bets. Wait for the current race to finish.")}
          </p>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-6 py-16 text-center">
      <div class="relative flex h-24 w-24 items-center justify-center rounded-full border border-red-800/40 bg-red-950/30">
        <div class="absolute inset-0 rounded-full bg-primary/10 blur-xl" />
        <img src="/images/icons/horse.png" alt="Horse" class="relative w-12 h-12 opacity-50" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white">{gettext("Horse Race is Inactive")}</h2>
        <p class="mt-2 text-sm text-gray-400">
          {gettext("The horse race is currently not available. Check back later.")}
        </p>
      </div>
      <.link
        navigate={~p"/app"}
        class="inline-flex items-center gap-2 rounded-xl border border-red-800/40 bg-red-950/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-red-900/30"
      >
        <.icon name="hero-arrow-left" class="w-4 h-4" />
        {gettext("Back to Home")}
      </.link>
    </div>
  <% end %>
</.page>
