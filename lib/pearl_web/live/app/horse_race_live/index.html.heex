<.page title={gettext("Horse Race")} size={:xl} title_class="uppercase">
  <:actions>
    <span class="text-semibold text-xl border-2 px-4 py-2 flex place-items-center gap-2">
      <.icon name="fa-sack-dollar-solid" />
      {@attendee_tokens}
    </span>
  </:actions>

  <%= if @horse_race_active? do %>
    <% total_bets = @horse_bets |> Map.values() |> Enum.sum() %>
    <% available_tokens = @attendee_tokens - total_bets %>

    <div class="flex flex-col gap-12 mt-12">
      <%!-- Betting Controls --%>
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center md:justify-between">
        <div class="w-full md:w-auto">
          <h2 class="text-2xl uppercase font-bold mb-6">
            {gettext("Place Your Bets")}
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 w-full md:w-auto">
            <%= for horse_num <- 1..@number_of_horses do %>
              <% horse_bet = Map.get(@horse_bets, horse_num, 0) %>
              <% has_bet = horse_bet > 0 %>
              <div class={[
                "flex flex-col items-center p-4 border-2 rounded-lg transition-all",
                if(has_bet,
                  do: "border-primary bg-primary/20",
                  else: "border-white/20 hover:border-white/40"
                )
              ]}>
                <span class="text-lg font-bold mb-2">Horse #{horse_num}</span>
                <img
                  src="/images/icons/horse.png"
                  alt="Horse #{horse_num}"
                  class="w-12 h-12 mb-3 brightness-0 invert"
                />
                <form phx-change="update_horse_bet" class="w-full mb-2">
                  <input type="hidden" name="horse" value={horse_num} />
                  <input
                    type="number"
                    name="amount"
                    phx-debounce="300"
                    value={if has_bet, do: horse_bet, else: ""}
                    min="1"
                    step="1"
                    max={trunc(available_tokens + horse_bet)}
                    placeholder="Amount"
                    disabled={@active_bets != []}
                    class="w-full px-2 py-1 text-center text-sm rounded border-2 border-white/20 bg-white/5 text-white placeholder-white/40 focus:border-primary focus:outline-none disabled:opacity-40"
                  />
                </form>
                <%= if has_bet do %>
                  <button
                    phx-click="clear_horse_bet"
                    phx-value-horse={horse_num}
                    class="w-full px-2 py-1 text-xs rounded bg-red-900/30 hover:bg-red-900/50 text-red-300 transition"
                  >
                    {gettext("Clear")}
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Stats Panel --%>
        <div class="flex border-2 divide-x-2 w-full md:w-auto md:flex-col md:divide-x-0 md:divide-y-2 p-4">
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Total Bet")}</p>
            <p class="text-2xl font-bold text-white">{format_tokens(total_bets)}</p>
          </div>
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Available")}</p>
            <p class="text-2xl font-bold text-primary">{format_tokens(available_tokens)}</p>
          </div>
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Multiplier")}</p>
            <p class="text-2xl font-bold text-white">{format_tokens(@multiplier)}x</p>
          </div>
        </div>
      </div>

      <%!-- Active Bets Section --%>
      <%= if @active_bets != [] do %>
        <div class="border-2 p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full bg-primary animate-pulse"></span>
            {gettext("Active Bets")}
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <%= for bet <- @active_bets do %>
              <div class="border border-primary/40 bg-primary/10 p-3 rounded text-center">
                <p class="text-lg font-bold">#{bet.horse_number}</p>
                <p class="text-xs text-gray-400 mt-1">{format_tokens(bet.bet_amount)}</p>
                <p class="text-sm font-bold text-primary mt-2">
                  {(format_tokens(bet.bet_amount) * @multiplier) |> format_tokens()}
                </p>
              </div>
            <% end %>
          </div>
          <p class="text-center text-sm text-gray-400 mt-6">
            {gettext("Waiting for race to finish...")}
          </p>
        </div>
      <% end %>

      <%!-- Action Buttons --%>
      <div class="flex gap-4 flex-col sm:flex-row">
        <button
          phx-click="clear_all_bets"
          disabled={map_size(@horse_bets) == 0 || @active_bets != []}
          class="px-6 py-3 border-2 rounded-lg font-bold disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {gettext("Clear All")}
        </button>
        <button
          phx-click="confirm_bets"
          disabled={map_size(@horse_bets) == 0 || @active_bets != []}
          class="h-20 border-2 w-full sm:w-auto border-white text-white transition-all hover:bg-white hover:text-black hover:border-white select-none disabled:opacity-75 disabled:cursor-not-allowed"
        >
          <p class="uppercase text-2xl font-bold">{gettext("Confirm Bets")}</p>
          <p class="text-sm">{gettext("%{amount} tokens", amount: format_tokens(total_bets))}</p>
        </button>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-6 py-24 text-center">
      <img
        src="/images/icons/horse.png"
        alt="Horse"
        class="w-20 h-20 opacity-50 brightness-0 invert"
      />
      <div>
        <h2 class="text-3xl font-bold">{gettext("Horse Race is Inactive")}</h2>
        <p class="text-gray-400 mt-2">
          {gettext("The horse race is not available at the moment. Check back soon.")}
        </p>
      </div>
      <.link
        navigate={~p"/app"}
        class="px-6 py-3 border-2 rounded-lg font-bold hover:bg-white/5 transition"
      >
        {gettext("Back to Games")}
      </.link>
    </div>
  <% end %>
</.page>
