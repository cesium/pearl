<.page title={gettext("Horse Race")} size={:xl} title_class="uppercase">
  <%= if @race_result do %>
    <.modal
      id="horse-race-result"
      show={true}
      on_cancel={JS.push("clear_result")}
      body_class="bg-darkShade border border-white/10 p-10 rounded-3xl shadow-2xl relative overflow-hidden max-w-2xl w-full mx-auto"
      phx-hook="Confetti"
      data-is_win={@race_result.winnings > 0}
      close_button={false}
    >
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-1/2 bg-primary/20 blur-[100px] pointer-events-none">
      </div>

      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="inline-flex items-center justify-center w-32 h-32 md:w-40 md:h-40 rounded-full bg-primary/10 border border-primary/20 mb-8 shadow-lg shadow-primary/20">
          <img
            src={~p"/images/icons/horse.png"}
            alt="Result"
            class="w-24 h-24 md:w-32 md:h-32 object-contain brightness-0 invert opacity-90"
          />
        </div>

        <h3 class="font-grotesk text-sm font-semibold tracking-widest text-lightMuted uppercase mb-3">
          <%= if @race_result.winnings > 0 do %>
            {gettext("Parabéns, Acertaste!")}
          <% else %>
            {gettext("Fim da Corrida")}
          <% end %>
        </h3>

        <p class="font-grotesk text-4xl md:text-5xl font-bold text-light mb-6 drop-shadow-md leading-tight">
          <%= if @race_result.winnings > 0 do %>
            {gettext("Ganhaste")}
            <span class="text-accent block mt-2">
              {format_tokens(@race_result.winnings)} tokens!
            </span>
          <% else %>
            {gettext("Perdeste")}
            <span class="text-red-500/90 block mt-2">
              {format_tokens(@race_result.losses)} tokens!
            </span>
            <span class="text-lightMuted block mt-2 text-2xl">{gettext("desta vez...")}</span>
          <% end %>
        </p>

        <p class="font-grotesk text-lg text-lightMuted mb-10 max-w-md">
          <%= if @race_result.winnings > 0 do %>
            {gettext("O cavalo #%{horse} foi o grande vencedor e trouxe-te sorte!",
              horse: @race_result.winning_horse
            )}
          <% else %>
            {gettext("O cavalo #%{horse} cruzou a meta primeiro. Melhor sorte na próxima aposta!",
              horse: @race_result.winning_horse
            )}
          <% end %>
        </p>

        <button
          phx-click="clear_result"
          class="inline-flex items-center justify-center px-10 py-4 bg-light hover:bg-light/90 text-dark font-grotesk font-bold text-lg rounded-full transition-transform hover:scale-105 shadow-lg shadow-light/10 uppercase tracking-wider"
        >
          {gettext("Continuar")}
        </button>
      </div>
    </.modal>
  <% end %>

  <:actions>
    <span class="text-semibold text-xl border-2 px-4 py-2 flex place-items-center gap-2">
      <.icon name="fa-sack-dollar-solid" />
      {@attendee_tokens}
    </span>
  </:actions>

  <%= if @horse_race_active? do %>
    <% total_bets = @horse_bets |> Map.values() |> Enum.sum() %>
    <% available_tokens = @attendee_tokens - total_bets %>

    <div class="flex flex-col gap-12 mt-12">
      <%!-- Betting Controls --%>
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center md:justify-between">
        <div class="w-full md:w-auto">
          <h2 class="text-2xl uppercase font-bold mb-6">
            {gettext("Place Your Bets")}
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full md:w-auto">
            <%= for horse_num <- 1..@number_of_horses do %>
              <% horse_bet = Map.get(@horse_bets, horse_num, 0) %>
              <% has_bet = horse_bet > 0 %>
              <div class={[
                "flex flex-col items-center p-6 md:p-8 border-2 rounded-xl transition-all",
                if(has_bet,
                  do: "border-primary bg-primary/20",
                  else: "border-white/20 hover:border-white/40"
                )
              ]}>
                <span class="text-xl md:text-2xl font-bold mb-4">Horse #{horse_num}</span>
                <img
                  src="/images/icons/horse.png"
                  alt="Horse #{horse_num}"
                  class="w-16 h-16 md:w-24 md:h-24 mb-4 brightness-0 invert"
                />
                <form phx-change="update_horse_bet" class="w-full mb-4">
                  <input type="hidden" name="horse" value={horse_num} />
                  <input
                    type="number"
                    name="amount"
                    phx-debounce="300"
                    value={if has_bet, do: horse_bet, else: ""}
                    min="1"
                    step="1"
                    max={trunc(available_tokens + horse_bet)}
                    placeholder="Amount"
                    disabled={@active_bets != [] || @horse_race_running?}
                    class="w-full px-4 py-3 text-center text-lg md:text-xl rounded-lg border-2 border-white/20 bg-white/5 text-white placeholder-white/40 focus:border-primary focus:outline-none disabled:opacity-40"
                  />
                </form>
                <%= if has_bet do %>
                  <button
                    phx-click="clear_horse_bet"
                    phx-value-horse={horse_num}
                    disabled={@horse_race_running?}
                    class="w-full px-4 py-2 text-sm md:text-base rounded bg-red-900/30 hover:bg-red-900/50 text-red-300 transition disabled:opacity-40 disabled:cursor-not-allowed"
                  >
                    {gettext("Clear")}
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Stats Panel --%>
        <div class="flex border-2 divide-x-2 w-full md:w-auto md:flex-col md:divide-x-0 md:divide-y-2 p-4">
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Total Bet")}</p>
            <p class="text-2xl font-bold text-white">{format_tokens(total_bets)}</p>
          </div>
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Available")}</p>
            <p class="text-2xl font-bold text-primary">{format_tokens(available_tokens)}</p>
          </div>
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Multiplier")}</p>
            <p class="text-2xl font-bold text-white">{format_tokens(@multiplier)}x</p>
          </div>
        </div>
      </div>

      <%!-- Active Bets Section --%>
      <%= if @active_bets != [] do %>
        <div class="border-2 p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full bg-primary animate-pulse"></span>
            {gettext("Active Bets")}
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-2 gap-4">
            <%= for bet <- @active_bets do %>
              <div class="border border-primary/40 bg-primary/10 p-6 rounded-xl text-center">
                <p class="text-2xl font-bold">#{bet.horse_number}</p>
                <p class="text-sm md:text-base text-gray-400 mt-2">
                  {format_tokens(bet.bet_amount)}
                </p>
                <p class="text-xl font-bold text-primary mt-3">
                  {(format_tokens(bet.bet_amount) * @multiplier) |> format_tokens()}
                </p>
              </div>
            <% end %>
          </div>
          <p class="text-center text-sm text-gray-400 mt-6">
            {gettext("Waiting for race to finish...")}
          </p>
        </div>
      <% end %>

      <%= if @horse_race_running? do %>
        <div class="text-center p-4 bg-primary/20 border border-primary text-primary rounded-lg font-bold animate-pulse">
          {gettext(
            "A corrida está a decorrer! Aguarda pelo final para poderes apostar novamente."
          )}
        </div>
      <% end %>

      <%!-- Action Buttons --%>
      <div class="flex gap-4 flex-col sm:flex-row">
        <button
          phx-click="clear_all_bets"
          disabled={map_size(@horse_bets) == 0 || @active_bets != [] || @horse_race_running?}
          class="px-6 py-3 border-2 font-bold disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {gettext("Clear All")}
        </button>
        <button
          phx-click="confirm_bets"
          disabled={map_size(@horse_bets) == 0 || @active_bets != [] || @horse_race_running?}
          class="p-2 h-20 border-2 w-full sm:w-auto border-white text-white hover:bg-white hover:text-black hover:border-white select-none disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-white disabled:hover:bg-black/10"
        >
          <p class="uppercase text-2xl font-bold">{gettext("Confirm Bets")}</p>
          <p class="text-sm">{gettext("%{amount} tokens", amount: format_tokens(total_bets))}</p>
        </button>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-6 py-24 text-center">
      <img
        src="/images/icons/horse.png"
        alt="Horse"
        class="w-20 h-20 opacity-50 brightness-0 invert"
      />
      <div>
        <h2 class="text-3xl font-bold">{gettext("Horse Race is currently not running")}</h2>
        <p class="text-gray-400 mt-2">
          {gettext("The horse race is not available at the moment. Check back soon.")}
        </p>
      </div>
      <.link
        navigate={~p"/app"}
        class="px-6 py-3 border-2 rounded-lg font-bold hover:bg-white/5 transition"
      >
        {gettext("Back to Games")}
      </.link>
    </div>
  <% end %>
</.page>
