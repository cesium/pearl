<.page title={gettext("Horse Race")} size={:xl} title_class="uppercase">
  <%= if @race_result do %>
    <.result_modal
      id="horse-race-result"
      show={true}
      on_cancel={JS.push("clear_result")}
      race_result={@race_result}
    />
  <% end %>

  <:actions>
    <span class="text-semibold text-xl border-2 px-4 py-2 flex place-items-center gap-2">
      <.icon name="fa-sack-dollar-solid" />
      {@attendee_tokens}
    </span>
  </:actions>

  <%= if @horse_race_active? do %>
    <% total_bets = @horse_bets |> Map.values() |> Enum.sum() %>
    <% available_tokens = @attendee_tokens - total_bets %>

    <div class="flex flex-col gap-12 mt-12">
      <%!-- Betting Controls --%>
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center md:justify-between">
        <div class="w-full md:w-auto">
          <h2 class="text-2xl uppercase font-bold mb-6">
            {gettext("Faz as tuas apostas")}
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full md:w-auto">
            <%= for horse_num <- 1..@number_of_horses do %>
              <% horse_bet = Map.get(@horse_bets, horse_num, 0) %>
              <% has_bet = horse_bet > 0 %>
              <div class={[
                "flex flex-col items-center p-6 md:p-8 border-2 rounded-xl transition-all",
                if(has_bet,
                  do: "border-primary bg-primary/20",
                  else: "border-white/20 hover:border-white/40"
                )
              ]}>
                <span class="text-xl md:text-2xl font-bold mb-4">Horse #{horse_num}</span>
                <div class="h-20 md:h-24 flex items-center justify-center mb-4 overflow-hidden w-32 md:w-36">
                  <div
                    class={[
                      "horse-icon shrink-0",
                      horse_variant_class(horse_num),
                      if(@horse_race_running?, do: "horse-run", else: "horse-rest")
                    ]}
                    style="transform: scale(0.6); transform-origin: center;"
                  >
                  </div>
                </div>
                <form phx-change="update_horse_bet" class="w-full mb-4">
                  <input type="hidden" name="horse" value={horse_num} />
                  <input
                    type="number"
                    name="amount"
                    phx-debounce="300"
                    value={if has_bet, do: horse_bet, else: ""}
                    min="1"
                    step="1"
                    max={trunc(available_tokens + horse_bet)}
                    placeholder="Valor"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                    disabled={@active_bets != [] || @horse_race_running?}
                    class="w-full px-4 py-3 text-center text-lg md:text-xl rounded-lg border-2 border-white/20 bg-white/5 text-white placeholder-white/40 focus:border-primary focus:outline-none disabled:opacity-40"
                  />
                </form>
                <%= if has_bet do %>
                  <button
                    phx-click="clear_horse_bet"
                    phx-value-horse={horse_num}
                    disabled={@horse_race_running?}
                    class="w-full px-4 py-2 text-sm md:text-base rounded bg-red-900/30 hover:bg-red-900/50 text-red-300 transition disabled:opacity-40 disabled:cursor-not-allowed"
                  >
                    {gettext("Limpar")}
                  </button>
                  <p class="text-sm text-gray-400 mt-2">
                    {gettext("Retorno se ganhar")}:
                    <span class="text-sm font-bold text-primary ml-2">
                      {format_tokens(trunc(horse_bet * trunc(@multiplier)))}
                    </span>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Stats Panel --%>
        <div class="flex border-2 divide-x-2 w-full md:w-auto md:flex-col md:divide-x-0 md:divide-y-2 p-4">
          <%= if @active_bets == [] do %>
            <div class="px-4 py-2 flex-1">
              <p class="text-sm text-gray-400">{gettext("Total apostado")}</p>
              <p class="text-2xl font-bold text-white">{format_tokens(trunc(total_bets))}</p>
            </div>
          <% end %>
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Disponível")}</p>
            <p class="text-2xl font-bold text-primary">
              {format_tokens(trunc(available_tokens))}
            </p>
          </div>
          <div class="px-4 py-2 flex-1">
            <p class="text-sm text-gray-400">{gettext("Multiplicador")}</p>
            <p class="text-2xl font-bold text-white">{format_tokens(trunc(@multiplier))}x</p>
          </div>
        </div>
      </div>

      <%!-- Active Bets Section --%>
      <%= if @active_bets != [] do %>
        <div class="border-2 p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full bg-primary animate-pulse"></span>
            {gettext("Apostas ativas")}
          </h3>
          <div class={[
            "grid gap-4",
            if(length(@active_bets) == 1, do: "grid-cols-1", else: "grid-cols-2 md:grid-cols-2")
          ]}>
            <%= for bet <- @active_bets do %>
              <div class={[
                "border border-primary/40 bg-primary/10 p-6 rounded-xl",
                if(length(@active_bets) == 1,
                  do: "flex justify-around items-center",
                  else: "text-center"
                )
              ]}>
                <p class="text-2xl font-bold">#{bet.horse_number}</p>
                <p class={[
                  "text-sm md:text-base text-gray-400",
                  if(length(@active_bets) == 1, do: "", else: "mt-2")
                ]}>
                  {format_tokens(bet.bet_amount)}
                </p>
                <% bet_amount_float = format_tokens(bet.bet_amount) %>
                <p class={[
                  "text-xl font-bold text-primary",
                  if(length(@active_bets) == 1, do: "", else: "mt-3")
                ]}>
                  {format_tokens(bet_amount_float * @multiplier)}
                </p>
              </div>
            <% end %>
          </div>
          <% total_active_bets =
            @active_bets
            |> Enum.map(& &1.bet_amount)
            |> Enum.reduce(Decimal.new(0), &Decimal.add/2) %>
          <% total_active_bets_float = format_tokens(total_active_bets) %>
          <% multiplier_decimal =
            cond do
              is_integer(@multiplier) -> Decimal.new(@multiplier)
              is_float(@multiplier) -> Decimal.from_float(@multiplier)
              match?(%Decimal{}, @multiplier) -> @multiplier
              true -> Decimal.new(trunc(@multiplier))
            end %>

          <% max_return =
            @active_bets
            |> Enum.map(& &1.bet_amount)
            |> Enum.map(fn bet -> Decimal.mult(bet, multiplier_decimal) end)
            |> Enum.reduce(nil, fn
              value, nil -> value
              value, acc -> if Decimal.compare(value, acc) == :gt, do: value, else: acc
            end) %>

          <% net_gain =
            if max_return && total_active_bets do
              Decimal.sub(max_return, total_active_bets)
            else
              Decimal.new(0)
            end %>

          <div class="grid border-2 w-full md:w-auto grid-cols-1 sm:grid-cols-3 gap-4 p-4 mt-6 items-end">
            <div class="px-4 py-2 text-center">
              <p class="text-sm text-gray-400">{gettext("Total apostado")}</p>
              <p class="text-2xl font-bold text-white">{total_active_bets_float}</p>
            </div>
            <div class="px-4 py-2 text-center">
              <p class="text-sm text-gray-400">{gettext("Máximo retorno")}</p>
              <p class="text-2xl font-bold text-primary">{format_tokens(max_return)}</p>
            </div>
            <div class="px-4 py-2 text-center">
              <p class="text-sm text-gray-400">
                {gettext("Ganho líquido (se o teu cavalo ganhar)")}
              </p>
              <p class="text-2xl font-bold text-emerald-400">{format_tokens(net_gain)}</p>
            </div>
          </div>

          <p class="text-center text-xs text-gray-400 mt-3 max-w-2xl mx-auto">
            {gettext(
              "Mostra o maior valor que podes ganhar se o teu cavalo for o vencedor. Nota: apenas a aposta vencedora é paga. O ganho líquido mostra o lucro real (máximo retorno − total apostado)."
            )}
          </p>
          <p class="text-center text-sm text-gray-400 mt-6">
            {gettext("À espera do fim da corrida...")}
          </p>
        </div>
      <% end %>

      <%= if @horse_race_running? do %>
        <div class="text-center p-4 bg-primary/20 border border-primary text-primary rounded-lg font-bold animate-pulse">
          {gettext(
            "A corrida está a decorrer! Aguarda pelo final para poderes apostar novamente."
          )}
        </div>
      <% end %>

      <%!-- Action Buttons --%>
      <div class="flex gap-4 flex-col sm:flex-row">
        <button
          phx-click="clear_all_bets"
          disabled={map_size(@horse_bets) == 0 || @active_bets != [] || @horse_race_running?}
          class="px-6 py-3 border-2 font-bold disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {gettext("Limpar tudo")}
        </button>
        <button
          phx-click="confirm_bets"
          disabled={map_size(@horse_bets) == 0 || @active_bets != [] || @horse_race_running?}
          class="p-2 h-20 border-2 w-full sm:w-auto border-white text-white hover:bg-white hover:text-black hover:border-white select-none disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-white disabled:hover:bg-black/10"
        >
          <p class="uppercase text-2xl font-bold">{gettext("Confirmar apostas")}</p>
          <p class="text-sm">
            {gettext("%{amount} tokens", amount: format_tokens(trunc(total_bets)))}
          </p>
        </button>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-6 py-24 text-center">
      <img
        src="/images/icons/horse.png"
        alt="Cavalo"
        class="w-20 h-20 opacity-50 brightness-0 invert"
      />
      <div>
        <h2 class="text-3xl font-bold">{gettext("A corrida de cavalos não está a decorrer")}</h2>
        <p class="text-gray-400 mt-2">
          {gettext("A corrida de cavalos não está disponível neste momento. Volta mais tarde.")}
        </p>
      </div>
      <.link
        navigate={~p"/app"}
        class="px-6 py-3 border-2 rounded-lg font-bold hover:bg-white/5 transition"
      >
        {gettext("Voltar aos jogos")}
      </.link>
    </div>
  <% end %>
</.page>
