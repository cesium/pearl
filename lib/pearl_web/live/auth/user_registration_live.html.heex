
    <div class="h-full flex flex-col">
          <div class="">
    </div>
      <.form
        for={@form}
        id="registration_form"
        phx-change="validate"
        phx-submit="save"
        class="flex-1 flex flex-col justify-between min-h-[500px]"
      >
        <div class="space-y-8">
              <.input
                field={@form[:name]}
                label="Nome"
                placeholder="Nome completo"
                variant={:flushed}
                wrapper_class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline"
                required
              />

              <div class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline">
                <.label for={@form[:email].id} class="text-dark">Email</.label>
                <div>
                  <.input
                    field={@form[:email]}
                    type="email"
                    placeholder="Endereço de email"
                    variant={:flushed}
                    required
                    label=""
                  />
                </div>
              </div>

              <.input
                field={@form[:handle]}
                label="Handle"
                placeholder="Jonas123"
                type="handle"
                variant={:flushed}
                wrapper_class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline"
                required
              />

              <.input
                field={@form[:password]}
                label="Password"
                type="password"
                placeholder="VeryStrongPassword1234@"
                variant={:flushed}
                wrapper_class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline"
                required
              />

              <div class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline">
                <label class="block text-[17.5px] font-bold text-dark">
                  Data de Nascimento
                </label>

                <% field = @form[:birth_date] %>
                <% value = Phoenix.HTML.Form.input_value(@form, :birth_date) %>

                <div class="flex gap-5">
                  <div class="w-25">
                    <select
                      name={field.name <> "[day]"}
                      id={field.id <> "_day"}
                      class="w-full bg-transparent border-0 border-b border-dark-muted/30 py-2.5 text-dark-muted focus:outline-none focus:border-primary focus:ring-0 transition-colors"
                    >
                      <option value="">Dia</option>
                      <%= for d <- @days do %>
                        <% selected =
                          value &&
                            ((is_map(value) && value["day"] == to_string(d)) ||
                              (is_struct(value) && value.day == d)) %>
                        <option value={d} selected={selected}>{d}</option>
                      <% end %>
                    </select>
                  </div>

                  <div class="w-40">
                    <select
                      name={field.name <> "[month]"}
                      id={field.id <> "_month"}
                      class="w-full bg-transparent border-0 border-b border-dark-muted/30 py-2.5 text-dark-muted focus:outline-none focus:border-primary focus:ring-0 transition-colors"
                    >
                      <option value="">Mês</option>
                      <%= for {name, m} <- @months do %>
                        <% selected =
                          value &&
                            ((is_map(value) && value["month"] == to_string(m)) ||
                              (is_struct(value) && value.month == m)) %>
                        <option value={m} selected={selected}>{name}</option>
                      <% end %>
                    </select>
                  </div>

                  <div class="w-30">
                    <select
                      name={field.name <> "[year]"}
                      id={field.id <> "_year"}
                      class="w-full bg-transparent border-0 border-b border-dark-muted/30 py-2.5 text-dark-muted focus:outline-none focus:border-primary focus:ring-0 transition-colors"
                    >
                      <option value="">Ano</option>
                      <%= for y <- @years do %>
                        <% selected =
                          value &&
                            ((is_map(value) && value["year"] == to_string(y)) ||
                              (is_struct(value) && value.year == y)) %>
                        <option value={y} selected={selected}>{y}</option>
                      <% end %>
                    </select>
                  </div>
                </div>
                <.error :for={msg <- field.errors}>{msg}</.error>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline">
                <label class="block text-[17.5px] font-bold text-dark">Telefone</label>
                <div class="flex gap-5">
                  <div class="w-40">
                    <.input
                      field={@form[:phone_prefix]}
                      type="select"
                      options={[{"PT (+351)", "+351"}, {"ES (+34)", "+34"}]}
                      variant={:flushed}
                      label=""
                    />
                  </div>
                  <div class="flex-1">
                    <.input
                      field={@form[:phone_number]}
                      placeholder="Número de telefone"
                      variant={:flushed}
                      label=""
                    />
                  </div>
                </div>
              </div>

              <.input
                field={@form[:university]}
                type="select"
                label="Universidade"
                options={@universities}
                prompt="Selecionar instituição"
                variant={:flushed}
                wrapper_class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline"
                required
              />

              <.input
                field={@form[:city]}
                type="select"
                label="Cidade"
                options={@cities}
                prompt="Selecionar cidade"
                variant={:flushed}
                wrapper_class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline"
                required
              />

              <.input
                field={@form[:nif]}
                label="NIF"
                placeholder="Número de Identificação Fiscal"
                variant={:flushed}
                wrapper_class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-25 items-baseline"
              />
        </div>
        <div class="sticky bottom-4 py-4 flex justify-end pointer-events-none">
          <div class="flex gap-2 pointer-events-auto">
            <.button type="submit">
              Enviar
            </.button>
          </div>
        </div>
      </.form>
    </div>