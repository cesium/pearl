<.hero
  title={gettext("Desafios")}
  description={
    gettext(
      "Quanto mais participas no ENEI, mais te habilitas a ganhar grandes prémios. Descobre os desafios que te esperam."
    )
  }
/>

<div class="w-full mx-auto px-4 md:px-12.5 mb-14.5 lg:mb-20 pt-8">
  <div class="xl:mt-8 xl:mb-24 grid grid-cols-1 gap-12 xl:grid-cols-[400px_1fr]">
    <div class="hidden xl:block">
      <.challenges_list
        challenges={@challenges}
        selected_challenge_id={@selected_challenge.id}
      />
    </div>

    <div class="hidden xl:block">
      <.challenge_detail challenge={@selected_challenge} />
    </div>

    <div class="xl:hidden">
      <%= if assigns[:mobile_selected_challenge] do %>
        <.challenge_detail challenge={@mobile_selected_challenge} />
      <% else %>
        <div class="px-4 md:px-0">
          <.challenges_list challenges={@challenges} />
        </div>
      <% end %>
    </div>
  </div>
</div>
