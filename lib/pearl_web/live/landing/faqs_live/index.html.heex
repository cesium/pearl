<div>
  <div class="bg-dotted flex flex-col gap-10 py-16 xl:px-28 md:px-20 px-10 relative">
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-linear-to-t from-background-muted to-transparent pointer-events-none">
    </div>
    <h1 class="text-4xl font-semibold">
      {gettext("Informação")} <span class="opacity-50">&</span> {gettext("Ajuda")}
    </h1>
    <div class="bg-white h-full">
      <div class="w-full h-35 flex flex-row">
        <!-- Countdown -->
        <div class="py-9 pl-9 flex flex-row w-1/2">
          <div class="w-full">
            <p class="uppercase opacity-50">Countdown</p>
            <p class="font-semibold text-2xl">
              para <span class="lowercase text-primary">{Timex.lformat!(@event_start_date, "{D} de {Mfull}", "pt")}</span>, faltam:
            </p>
          </div>
          <!--
          <div id="countdown-timer" phx-hook="LandingCountdown" data-date={@event_start_date}></div>
          -->
        </div>
        <!-- Ticket -->
        <div class="w-1/2 flex flex-row h-full bg-[#E7DCDC] group cursor-pointer">
          <div class="w-3/5 flex flex-row justify-center relative">
            <.ticket class="w-89 absolute -bottom-8 z-0 group-hover:-bottom-5 transition-all" />
          </div>
          <div class="w-2/5 flex flex-col justify-center">
            <p class="lowercase text-base text-primary px-12">
              {gettext("Os bilhetes entram em pré-venda no dia ")}<b>{gettext("30 de janeiro")}</b>
            </p>
          </div>
        </div>
      </div>
      <div class="w-full flex flex-row h-full relative z-1 bg-white">
        <!-- Map -->
        <.link
          class="w-1/2 h-full group overflow-hidden"
          href="https://maps.app.goo.gl/LcEmS2fv6qFRdabR8"
          target="_blank"
        >
          <img
            class="w-full h-92 object-cover group-hover:scale-110 transition-all"
            src={~p"/images/information/map.svg"}
            alt=""
          />
        </.link>
        <!-- Location details -->
        <div class="w-1/2 pl-8 flex flex-col gap-4 justify-center">
          <img class="w-64" src={~p"/images/information/forum.jpg"} alt="" />
          <p class="font-semibold text-xl">Fórum Braga</p>
          <div>
            <p class="uppercase text-sm opacity-50">{gettext("Entrada Principal")}</p>
            <p>{gettext("Av. Dr. Francisco Pires Gonçalves, 4715-558")}</p>
            <p>{gettext("Braga, Portugal")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="xl:px-28 md:px-20 px-10 flex flex-col gap-12 pb-20">
    <div>
      <h2 class="text-2xl font-semibold">{gettext("FAQs")}</h2>
      <p class="pt-1 pb-6">
        {gettext(
          "Esclarece as tuas dúvidas relativas ao evento com as nossas respostas (e aproveita algumas dicas)."
        )}
      </p>
      <.faq
        :for={{id, faq} <- @streams.faqs}
        id={id}
        topic={faq.topic}
        question={faq.question}
        answer={faq.answer}
      />
    </div>
    <.contacts />
  </div>
</div>
