<div>
  <.hero
    event_start_date={@event_start_date}
    event_end_date={@event_end_date}
  />
  <div id="info-section">
    <.announcement_bar />
    <.info_section />
  </div>
</div>
<div class="px-8 md:px-12.5 lg:px-16 pb-10 md:pb-14.5 bg-white">
  <.activities />
  <.sponsors :if={@has_sponsors?} tiers={@tiers} />
  <.partners />
</div>
