<div>
  <.hero
    event_start_date={@event_start_date}
    event_end_date={@event_end_date}
  />
  <div id="info-section">
    <.announcement_bar />
    <.info_section />
  </div>
</div>
<.activities />
<.speakers
  speakers={@speakers}
  selected_speaker={@selected_speaker}
  selected_activity={@selected_activity}
/>
<div class="px-8 md:px-12.5 lg:px-16 bg-white">
  <.sponsors :if={@has_sponsors?} tiers={@tiers} />
  <.promo_cards />
  <.link_wrapup is_register_open?={@is_register_open?} />
</div>
