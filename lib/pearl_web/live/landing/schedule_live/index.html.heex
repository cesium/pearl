<div>
  <div>
    <.live_component
      id={:schedule}
      module={PearlWeb.Landing.Components.Schedule}
      event_start_date={@event_start_date}
      event_end_date={@event_end_date}
      url={~p"/schedule"}
      has_filters?={true}
      params={@params}
      current_user={@current_user}
    />
  </div>

  <div class="flex flex-col items-center justify-center py-16 px-8 bg-light">
    <h2 class="text-2xl md:text-3xl font-semibold text-dark text-center mb-4">
      {gettext("Conhece os oradores")}
    </h2>
    <p class="text-dark/70 text-center max-w-2xl mb-8">
      {gettext(
        "Os oradores fazem os eventos do ENEI acontecer. Carrega no botão abaixo para conhecer mais sobre quem são, de que empresa vêm e o seu impacto. Também poderás ver os seus perfis do LinkedIn ou os sites das suas empresas."
      )}
    </p>
    <.link
      navigate={~p"/speakers"}
      class="flex items-center gap-2 px-6 py-3 bg-primary text-white text-sm transition-all"
    >
      <.icon name="hero-arrow-right" class="h-4 w-4" />
      <span>{gettext("conhece os oradores")}</span>
    </.link>
  </div>
</div>
