<div class="py-14 sm:py-28 xl:px-[15rem] md:px-[8rem] px-[2.5rem]">
  <div class="relative z-20 flex flex-col justify-between py-20 lg:h-3/4">
    <div class="font-terminal uppercase relative z-50 font-bold animate-slide-in">
      <h5 class="text-accent text-2xl">
        Tickets
      </h5>
    </div>
    <div class="mt-16 grid sm:grid-cols-2 2xl:grid-cols-4 justify-between place-items-center gap-8">
      <.card :for={ticket_type <- @ticket_types} ticket_type={ticket_type} />
    </div>
  </div>
</div>
